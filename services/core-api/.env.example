# =============================================================
# Core API Environment Variables
# =============================================================
# Copy this file to .env and customize for your environment.
# DO NOT commit .env to version control!
# =============================================================

# Server
NODE_ENV=development
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=koyla
DB_PASSWORD=koyla_dev
DB_NAME=koyla_chain
DB_NAME_TEST=koyla_chain_test

# Redis
REDIS_URL=redis://localhost:6379

# JWT — CHANGE THESE IN PRODUCTION
JWT_SECRET=dev-secret-change-in-production-minimum-32-chars!!
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production!!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Internal API key (for AI service communication)
INTERNAL_API_KEY=dev-internal-api-key-change-in-production

# AI Service URL
AI_SERVICE_URL=http://localhost:8000

# Rate Limiting
RATE_LIMIT_SYNC_WINDOW=60000
RATE_LIMIT_SYNC_MAX=30

# CORS (comma-separated in production)
# CORS_ORIGIN=https://admin.koyla-chain.in
